# Where the Go API lives. Note the /api suffix: every path in openapi.yaml is
# relative to it, and api.ts never repeats it. Blueprint B11.
#
# Inlined at build time ($env/static/public), so pointing a build at a
# different API means rebuilding. Must agree with the API's ALLOWED_ORIGINS.
PUBLIC_API_URL=http://localhost:1304/api
